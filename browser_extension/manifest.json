{
  "manifest_version": 3,
  "name": "CommandCenter 只读观察器",
  "version": "0.1.0",
  "description": "开发测试用的选中标签页只读观察器。",
  "permissions": ["activeTab", "debugger"],
  "host_permissions": [
    "http://yifeng.dtsum.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["http://yifeng.dtsum.com/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
