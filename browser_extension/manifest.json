{
  "manifest_version": 3,
  "name": "CommandCenter Recorder Shell",
  "version": "0.1.0",
  "description": "Test-only selected-tab UI recorder shell.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://yifeng.dtsum.com/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["http://yifeng.dtsum.com/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
